# Copy to .env in the project root (or beside the portable executable).
# Loaded at startup; restart the server after editing. System environment wins.
# Values may be unquoted or enclosed in single/double quotes. No expansion.
# Invoices: Tencent OCR first when both credentials are present; otherwise local.
# Bank statements always use local parsing and never call Tencent OCR.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Optional temporary-credential token and API region; no region is forced.
TENCENTCLOUD_TOKEN=
TENCENTCLOUD_REGION=
